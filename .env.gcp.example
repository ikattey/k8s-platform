# ---------------------------------------------------------------------------
# GCP GKE
# ---------------------------------------------------------------------------

# GCP credentials
# Auth: gcloud auth login && gcloud auth application-default login
export TF_VAR_project_id=""
export TF_VAR_region="europe-west2"
export TF_VAR_location="europe-west2-a"
export TF_VAR_environment="production"

# Cluster
export TF_VAR_cluster_name="gcp-starter"
export TF_VAR_cloud_provider="gcp"
export CLUSTER=gcp-starter

# State backend (GCS bucket you created in the prerequisites)
export TF_VAR_state_bucket=""

# OIDC / SSO
# On GCP, OIDC here applies to ArgoCD and Grafana only.
# kubectl access should use:
# gcloud container clusters get-credentials "$TF_VAR_cluster_name" --location "$TF_VAR_location" --project "$TF_VAR_project_id"
export TF_VAR_enable_oidc=true
export TF_VAR_oidc_issuer_url="https://accounts.google.com"
export TF_VAR_oidc_allowed_domains=""
export TF_VAR_argocd_oidc_client_id=""
export TF_VAR_argocd_oidc_client_secret=""
export TF_VAR_grafana_oauth_client_id=""
export TF_VAR_grafana_oauth_client_secret=""
export TF_VAR_kubectl_oidc_client_id=""
export TF_VAR_kubectl_oidc_client_secret=""
