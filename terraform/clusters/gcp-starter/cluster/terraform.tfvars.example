project_id   = "your-gcp-project"
cluster_name = "gcp-starter"
domain       = "example.com"
region       = "europe-west1"
location     = "europe-west1-b"

environment = "production"

node_count     = 3
max_node_count = 6
machine_type   = "e2-standard-4"

# Storage node pool (optional)
# enable_storage_node_pool = true
# storage_node_count       = 1
# storage_max_node_count   = 2
# storage_machine_type     = "n2-standard-2"

# Backup bucket (optional; enabled by default)
# create_backup_bucket     = true

# Managed database options
# database_provider          = "managed"  # or cnpg (default) or external
# cloud_sql_tier            = "db-custom-2-4096"
# cloud_sql_disk_size_gb    = 20
# cloud_sql_availability_type = "ZONAL"
