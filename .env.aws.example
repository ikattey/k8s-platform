# ---------------------------------------------------------------------------
# AWS EKS
# ---------------------------------------------------------------------------

# AWS credentials (IAM user with programmatic access)
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="eu-north-1"
export AWS_REGION="eu-north-1"

# Cluster
export TF_VAR_cluster_name="aws-starter"
export TF_VAR_cloud_provider="aws"
export CLUSTER=aws-starter

# State backend (S3 bucket you created in the prerequisites)
export TF_VAR_state_bucket=""
export TF_VAR_state_region=""
